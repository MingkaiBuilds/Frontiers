---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ReportGraph from '@/components/ReportGraph.astro';
import { frontierByName } from '@/data/frontiers';
import { withBase } from '@/utils/paths';
import { COPYRIGHT_YEAR, CREATOR_NAME, DISCUSSION_URLS, SITE_MARK, SITE_NAME } from '@/data/site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
  headings: Heading[];
}

const { post, allPosts, headings } = Astro.props;
const frontier = frontierByName.get(post.data.frontier);
const date = post.data.published.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const reviewedDate = (post.data.lastReviewed ?? post.data.updated ?? post.data.published).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const modifiedDate = post.data.updated ?? post.data.published;
const citation = `${post.data.author}. “${post.data.title}.” ${SITE_NAME}, ${post.data.published.getUTCFullYear()}, ${canonicalURL.href}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  dateModified: modifiedDate.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    founder: { '@type': 'Person', name: CREATOR_NAME },
  },
  copyrightHolder: { '@type': 'Person', name: post.data.copyrightHolder },
  copyrightYear: post.data.published.getUTCFullYear(),
  articleSection: post.data.frontier,
  proficiencyLevel: post.data.difficulty,
  mainEntityOfPage: canonicalURL.href,
  url: canonicalURL.href,
};
---

<BaseLayout
  title={`${post.data.title} — Physical Extremes`}
  description={post.data.description}
  article
  structuredData={structuredData}
  articleMeta={{
    published: post.data.published,
    updated: post.data.updated,
    author: post.data.author,
    section: post.data.frontier,
  }}
>
  <article style={`--frontier-color: ${frontier?.color ?? '#b8f45d'}`}>
    <header class="report-hero border-b border-white/10">
      <div class="mx-auto max-w-[1480px] px-5 py-12 md:px-8 md:py-20">
        <a href={withBase('/#reports')} class="eyebrow-link">← Return to report index</a>
        <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_290px] lg:gap-20">
          <div class="max-w-5xl">
            <div class="flex items-center gap-3 text-[10px] tracking-[0.17em] text-zinc-500 uppercase">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--frontier-color)] shadow-[0_0_14px_var(--frontier-color)]"></span>
              <span>{post.data.frontier}</span>
              <span class="text-zinc-800">/</span>
              <span>{post.data.reportNo}</span>
            </div>
            <h1 class="mt-6 max-w-[18ch] text-[clamp(2.6rem,7vw,6.6rem)] leading-[0.94] font-medium tracking-[-0.065em] text-zinc-100">
              {post.data.title}
            </h1>
            <p class="mt-7 max-w-3xl text-base leading-7 text-zinc-400 md:text-lg md:leading-8">
              {post.data.description}
            </p>
          </div>

          <dl class="report-metadata self-end border-t border-white/10 pt-5 font-mono text-[10px]">
            <div><dt>Published</dt><dd>{date}</dd></div>
            <div><dt>Author</dt><dd>{post.data.author}</dd></div>
            <div><dt>Revision</dt><dd>v{post.data.revision}</dd></div>
            <div><dt>Last reviewed</dt><dd>{reviewedDate}</dd></div>
          </dl>
        </div>

        <dl class="trust-register mt-10" aria-label="Report trust and maturity indicators">
          <div><dt>Difficulty</dt><dd>{post.data.difficulty}</dd></div>
          <div><dt>Evidence</dt><dd>{post.data.evidenceStatus}</dd></div>
          <div><dt>Readiness</dt><dd>TRL {post.data.readinessLevel} / 9</dd></div>
          <div><dt>Review</dt><dd>{post.data.reviewStatus}</dd></div>
          <div><dt>Sources</dt><dd>{post.data.references.length}</dd></div>
          <div><dt>Reading time</dt><dd>{post.data.readingTime}</dd></div>
        </dl>
      </div>
    </header>

    <div class="mx-auto grid max-w-[1480px] gap-12 px-5 py-12 md:px-8 lg:grid-cols-[210px_minmax(0,760px)_1fr] lg:gap-14 lg:py-20">
      <aside class="hidden lg:block">
        <div class="sticky top-8">
          <p class="mb-5 font-mono text-[9px] tracking-[0.18em] text-zinc-600 uppercase">On this page</p>
          <nav aria-label="Table of contents">
            <ol class="space-y-3 border-l border-white/10">
              {toc.map((heading) => (
                <li class:list={[heading.depth === 3 && 'pl-3']}>
                  <a class="toc-link" href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>

      <div class="min-w-0">
        <div class="prose">
          <slot />
        </div>

        {post.data.references.length > 0 && (
          <section class="report-supplement" aria-labelledby="report-sources">
            <p class="section-kicker">Evidence register</p>
            <h2 id="report-sources">Sources</h2>
            <ol class="source-register">
              {post.data.references.map((reference) => (
                <li>
                  <a href={reference.url} rel="noreferrer">{reference.title}</a>
                  {reference.publisher && <span>{reference.publisher}</span>}
                </li>
              ))}
            </ol>
          </section>
        )}

        {post.data.openProblems.length > 0 && (
          <section class="report-supplement" aria-labelledby="report-open-problems">
            <p class="section-kicker">Unresolved work</p>
            <h2 id="report-open-problems">Open problems raised here</h2>
            <div class="problem-stack">
              {post.data.openProblems.map((problem) => (
                <article id={`open-problem-${problem.id}`} class="problem-brief">
                  <div class="problem-brief__meta">
                    <span>{problem.status}</span>
                    <span>{problem.disciplines.join(' · ') || post.data.frontier}</span>
                  </div>
                  <h3>{problem.title}</h3>
                  <p>{problem.question}</p>
                  <div><span>Next tractable step</span><strong>{problem.nextStep}</strong></div>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="report-participation" aria-labelledby="report-participation-title">
          <div>
            <p class="section-kicker">Continue the work</p>
            <h2 id="report-participation-title">Challenge, correct, or extend this report.</h2>
            <p>Bring evidence, expose a weak assumption, or propose the next experiment. Confirmed work can become a revision to the report.</p>
          </div>
          <div class="report-participation__actions">
            <a href={DISCUSSION_URLS.reportQuestions}>Ask about this report <span>↗</span></a>
            <a href={DISCUSSION_URLS.technicalCritique}>Submit technical critique <span>↗</span></a>
            <a href={withBase('/problems/')}>Browse open problems <span>→</span></a>
          </div>
        </section>

        <section class="report-rights border-t border-white/10 pt-8" aria-labelledby="report-rights-title">
          <p class="section-kicker">Authorship and provenance</p>
          <h2 id="report-rights-title" class="mt-4 text-xl font-medium tracking-[-.035em] text-zinc-300">A named, versioned record.</h2>
          <dl class="mt-6 grid gap-px bg-white/10 font-mono text-[9px] tracking-[.08em] uppercase sm:grid-cols-2">
            <div class="bg-[#080a0a] p-4"><dt class="text-zinc-700">Author</dt><dd class="mt-2 text-zinc-400">{post.data.author}</dd></div>
            <div class="bg-[#080a0a] p-4"><dt class="text-zinc-700">Rights holder</dt><dd class="mt-2 text-zinc-400">{post.data.copyrightHolder}</dd></div>
            <div class="bg-[#080a0a] p-4"><dt class="text-zinc-700">First published</dt><dd class="mt-2 text-zinc-400">{date}</dd></div>
            <div class="bg-[#080a0a] p-4"><dt class="text-zinc-700">Current revision</dt><dd class="mt-2 text-zinc-400">v{post.data.revision} / {modifiedDate.toISOString().slice(0, 10)}</dd></div>
          </dl>
          <p class="mt-5 text-xs leading-5 text-zinc-600">Suggested citation: {citation}</p>
          <p class="mt-3 font-mono text-[9px] tracking-[.08em] text-zinc-700 uppercase">© {post.data.published.getUTCFullYear() || COPYRIGHT_YEAR} {post.data.copyrightHolder}. {SITE_MARK}. All rights reserved.</p>
        </section>
      </div>

      <aside class="hidden xl:block">
        <div class="sticky top-24 ml-auto w-full max-w-[250px]">
          <details class="path-tracker" open>
            <summary>
              <span>Learning path</span>
              <span class="path-tracker__toggle" aria-hidden="true">±</span>
            </summary>
            <div class="path-tracker__body">
              <ReportGraph posts={allPosts} currentId={post.id} compact />
            </div>
          </details>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
