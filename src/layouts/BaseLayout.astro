---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import { withBase } from '@/utils/paths';
import {
  COPYRIGHT_YEAR,
  CREATOR_NAME,
  DISCUSSIONS_URL,
  SITE_MARK,
  SITE_NAME,
} from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  robots?: string;
  structuredData?: Record<string, unknown>;
  articleMeta?: {
    published: Date;
    updated?: Date;
    author: string;
    section: string;
  };
}

const {
  title = 'Physical Extremes — Engineering the Five Great Frontiers',
  description = 'Independent engineering reports on deep space, deep ocean, deep crust, fusion energy, and cryo-quantum infrastructure.',
  image = withBase('/og.png'),
  article = false,
  robots = 'index, follow',
  structuredData,
  articleMeta,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const pageStructuredData = structuredData ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: canonicalURL.href,
  creator: { '@type': 'Person', name: CREATOR_NAME },
  copyrightHolder: { '@type': 'Person', name: CREATOR_NAME },
  copyrightYear: COPYRIGHT_YEAR,
};
const serializedStructuredData = JSON.stringify(pageStructuredData).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en" class="bg-[#070909] text-zinc-200">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#070909" />
    <meta name="description" content={description} />
    <meta name="author" content={CREATOR_NAME} />
    <meta name="copyright" content={`© ${COPYRIGHT_YEAR} ${CREATOR_NAME}. All rights reserved.`} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title="Physical Extremes reports" href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {article && articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.published.toISOString()} />
        <meta property="article:modified_time" content={(articleMeta.updated ?? articleMeta.published).toISOString()} />
        <meta property="article:author" content={articleMeta.author} />
        <meta property="article:section" content={articleMeta.section} />
      </>
    )}
    <script type="application/ld+json" set:html={serializedStructuredData} is:inline></script>

    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased selection:bg-lime-300 selection:text-black">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ambient-grid" aria-hidden="true"></div>
    <SiteHeader compact={article} />
    <main id="main-content">
      <slot />
    </main>
    <footer class="border-t border-white/10">
      <div class="mx-auto flex max-w-[1480px] flex-col gap-3 px-5 py-7 text-[9px] tracking-[0.15em] text-zinc-600 uppercase md:flex-row md:items-center md:justify-between md:px-8">
        <p>© {COPYRIGHT_YEAR} {CREATOR_NAME} / {SITE_MARK} / All rights reserved</p>
        <div class="flex flex-wrap gap-4 font-mono">
          <a href={withBase('/about/')}>About / Colophon</a>
          <a href={withBase('/problems/')}>Open problems</a>
          <a href={DISCUSSIONS_URL}>Discussions</a>
          <a href={withBase('/rss.xml')}>RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>
