---
import type { CollectionEntry } from 'astro:content';
import { FRONTIERS, frontierByName } from '@/data/frontiers';
import { withBase } from '@/utils/paths';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentId?: string;
  compact?: boolean;
}

interface GraphNode {
  id: string;
  title: string;
  reportNo: string;
  frontier: string;
  color: string;
  href: string;
  depth: number;
  x: number;
  y: number;
  lines: string[];
}

const { posts, currentId, compact = false } = Astro.props;
const postById = new Map(posts.map((post) => [post.id, post]));
const depthCache = new Map<string, number>();

// Calculate a deterministic topological depth and fail the build for invalid
// references or circular curricula. Broken learning paths should never ship.
function getDepth(id: string, ancestry = new Set<string>()): number {
  const cached = depthCache.get(id);
  if (cached !== undefined) return cached;
  if (ancestry.has(id)) throw new Error(`Circular report prerequisite detected at "${id}".`);

  const post = postById.get(id);
  if (!post) throw new Error(`Unknown report prerequisite "${id}".`);

  const nextAncestry = new Set(ancestry).add(id);
  const prerequisiteDepths = post.data.prerequisites.map((prerequisiteId) => {
    if (!postById.has(prerequisiteId)) {
      throw new Error(`Report "${id}" references missing prerequisite "${prerequisiteId}".`);
    }
    return getDepth(prerequisiteId, nextAncestry);
  });
  const depth = prerequisiteDepths.length ? Math.max(...prerequisiteDepths) + 1 : 0;
  depthCache.set(id, depth);
  return depth;
}

function wrapTitle(title: string, maxCharacters = 25): string[] {
  const words = title.split(' ');
  const lines: string[] = [];

  for (const word of words) {
    const last = lines.at(-1);
    if (!last || `${last} ${word}`.length > maxCharacters) lines.push(word);
    else lines[lines.length - 1] = `${last} ${word}`;
  }

  if (lines.length > 2) return [lines[0], `${lines[1]}…`];
  return lines;
}

const orderedPosts = [...posts].sort((a, b) => {
  const depthDifference = getDepth(a.id) - getDepth(b.id);
  return depthDifference || a.data.published.valueOf() - b.data.published.valueOf();
});
const maxDepth = Math.max(1, ...orderedPosts.map((post) => getDepth(post.id)));
const activeFrontiers = FRONTIERS.filter((frontier) =>
  orderedPosts.some((post) => post.data.frontier === frontier.name),
);
const frontierIndex = new Map(activeFrontiers.map((frontier, index) => [frontier.name, index]));
const fullNodeWidth = 220;
const fullNodeHeight = 88;
const fullDepthGap = 288;
const fullViewportWidth = 1200;
const fullViewportHeight = 620;
const fullWorldWidth = Math.max(1500, 150 + maxDepth * fullDepthGap + fullNodeWidth + 150);
const fullWorldHeight = Math.max(700, 160 + Math.max(0, activeFrontiers.length - 1) * 250);
const frontierDepthGroups = new Map<string, CollectionEntry<'blog'>[]>();

for (const post of orderedPosts) {
  const depth = getDepth(post.id);
  const key = `${post.data.frontier}:${depth}`;
  frontierDepthGroups.set(key, [...(frontierDepthGroups.get(key) ?? []), post]);
}

const graphNodes: GraphNode[] = orderedPosts.map((post, orderedIndex) => {
  const depth = getDepth(post.id);
  const routeGroup = frontierDepthGroups.get(`${post.data.frontier}:${depth}`) ?? [];
  const routeGroupIndex = routeGroup.findIndex((item) => item.id === post.id);
  const laneIndex = frontierIndex.get(post.data.frontier) ?? 0;
  const laneY = activeFrontiers.length === 1 ? fullWorldHeight / 2 : 80 + laneIndex * 250;
  const frontier = frontierByName.get(post.data.frontier);

  return {
    id: post.id,
    title: post.data.title,
    reportNo: post.data.reportNo,
    frontier: post.data.frontier,
    color: frontier?.color ?? '#b8f45d',
    href: withBase(`/reports/${post.id}/`),
    depth,
    x: compact ? 28 + depth * 18 : 120 + depth * fullDepthGap,
    y: compact
      ? 26 + orderedIndex * 64
      : laneY - fullNodeHeight / 2 + (routeGroupIndex - (routeGroup.length - 1) / 2) * 112,
    lines: wrapTitle(post.data.title),
  };
});

const frontierLanes = activeFrontiers.map((frontier, index) => ({
  ...frontier,
  y: activeFrontiers.length === 1 ? fullWorldHeight / 2 : 80 + index * 250,
  count: graphNodes.filter((node) => node.frontier === frontier.name).length,
}));

const nodeById = new Map(graphNodes.map((node) => [node.id, node]));
const edges = orderedPosts.flatMap((post) =>
  post.data.prerequisites.map((sourceId) => ({
    source: nodeById.get(sourceId)!,
    target: nodeById.get(post.id)!,
  })),
);
const viewWidth = compact ? 260 : fullViewportWidth;
const viewHeight = compact ? Math.max(210, graphNodes.length * 64 + 10) : fullViewportHeight;
const titleId = `graph-title-${compact ? 'compact' : 'full'}-${currentId?.replaceAll('/', '-') ?? 'index'}`;
const studioHref = withBase('/studio/');
const authorMode = import.meta.env.DEV;
---

<div
  class:list={['report-graph', compact && 'report-graph--compact']}
  data-report-graph
  data-current-id={currentId}
>
  <div class="graph-toolbar">
    {graphNodes.length ? (
      <div class="graph-legend" aria-hidden="true">
        <span><i class="legend-dot legend-dot--unread"></i> Unread</span>
        <span><i class="legend-dot legend-dot--visited"></i> Visited</span>
        <span><i class="legend-dot legend-dot--current"></i> Current</span>
      </div>
    ) : <p>Dependency field / awaiting origin node</p>}
    <div class="graph-toolbar__status">
      <p><span data-progress-count>0</span> / {graphNodes.length} nodes traversed</p>
      {!compact && graphNodes.length > 0 && (
        <div class="graph-controls" aria-label="Graph view controls">
          <button type="button" data-graph-action="start" aria-label="Return to the beginning of the selected route">Start</button>
          <button type="button" data-graph-action="fit" aria-label="Fit the complete graph in view">Fit all</button>
          <button type="button" data-graph-action="zoom-out" aria-label="Zoom out">−</button>
          <span data-zoom-level aria-live="polite">100%</span>
          <button type="button" data-graph-action="zoom-in" aria-label="Zoom in">+</button>
        </div>
      )}
    </div>
  </div>

  {!compact && frontierLanes.length > 0 && (
    <div class="graph-routes" aria-label="Choose a frontier path">
      <span>Follow frontier</span>
      {frontierLanes.map((frontier, index) => (
        <button
          type="button"
          class:list={[index === 0 && 'is-selected']}
          style={`--route-color: ${frontier.color}`}
          data-graph-route={frontier.name}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <i></i>{frontier.name}<small>{String(frontier.count).padStart(2, '0')}</small>
        </button>
      ))}
    </div>
  )}

  <div
    class="graph-viewport"
    tabindex="0"
    aria-label={compact ? 'Report prerequisite graph' : 'Interactive report map. Drag or scroll to move through the frontier path.'}
    data-world-width={fullWorldWidth}
    data-world-height={fullWorldHeight}
  >
    {graphNodes.length === 0 ? (
      <div class="graph-empty">
        <span class="graph-empty__origin" aria-hidden="true"></span>
        <p>NO REPORT NODES INDEXED</p>
        <strong>The learning path begins with the first transmission.</strong>
        {authorMode ? <a href={studioHref}>Open report studio →</a> : <span class="graph-empty__status">Awaiting first report</span>}
      </div>
    ) : (
    <svg
      viewBox={`0 0 ${viewWidth} ${viewHeight}`}
      role="img"
      aria-labelledby={titleId}
      preserveAspectRatio={compact ? 'xMinYMin meet' : 'xMidYMid meet'}
    >
      <title id={titleId}>Technical report prerequisite graph</title>
      <defs>
        <marker id={`graph-arrow-${compact ? 'compact' : 'full'}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-head"></path>
        </marker>
      </defs>

      <g data-graph-stage>
      {!compact && (
        <g class="graph-lanes" aria-hidden="true">
          {frontierLanes.map((frontier) => (
            <>
              <line x1="30" y1={frontier.y} x2={fullWorldWidth - 30} y2={frontier.y}></line>
              <text x="38" y={frontier.y - 70} style={`--lane-color: ${frontier.color}`}>
                {frontier.name} / {String(frontier.count).padStart(2, '0')} reports
              </text>
            </>
          ))}
        </g>
      )}

      <g class="graph-edges" aria-hidden="true">
        {edges.map(({ source, target }) => {
          const sourceX = compact ? source.x : source.x + fullNodeWidth;
          const sourceY = compact ? source.y : source.y + fullNodeHeight / 2;
          const targetX = target.x;
          const targetY = compact ? target.y : target.y + fullNodeHeight / 2;
          const control = Math.max(28, (targetX - sourceX) * 0.52);
          const path = `M ${sourceX} ${sourceY} C ${sourceX + control} ${sourceY}, ${targetX - control} ${targetY}, ${targetX} ${targetY}`;

          return (
            <path
              class="graph-edge"
              d={path}
              data-from={source.id}
              data-to={target.id}
              marker-end={`url(#graph-arrow-${compact ? 'compact' : 'full'})`}
            />
          );
        })}
      </g>

      <g class="graph-nodes">
        {graphNodes.map((node) => (
          <a
            href={node.href}
            class:list={['graph-node', node.id === currentId && 'is-current']}
            style={`--node-color: ${node.color}`}
            data-graph-node
            data-node-id={node.id}
            data-frontier={node.frontier}
            data-node-x={node.x}
            data-node-y={node.y}
            aria-current={node.id === currentId ? 'page' : undefined}
          >
            <title>{node.title}. {node.frontier}. {node.depth === 0 ? 'Entry point.' : `Level ${node.depth + 1}.`}</title>
            {compact ? (
              <>
                <circle class="node-halo" cx={node.x} cy={node.y} r="11"></circle>
                <circle class="node-core" cx={node.x} cy={node.y} r="4"></circle>
                <text class="node-code" x={node.x + 19} y={node.y - 3}>{node.reportNo}</text>
                <text class="node-title" x={node.x + 19} y={node.y + 12}>{node.title.length > 28 ? `${node.title.slice(0, 27)}…` : node.title}</text>
              </>
            ) : (
              <>
                <rect class="node-shell" x={node.x} y={node.y} width={fullNodeWidth} height={fullNodeHeight} rx="2"></rect>
                <line class="node-signal" x1={node.x} y1={node.y} x2={node.x + fullNodeWidth} y2={node.y}></line>
                <circle class="node-core" cx={node.x + 17} cy={node.y + 18} r="3.5"></circle>
                <text class="node-code" x={node.x + 29} y={node.y + 21}>{node.reportNo}</text>
                <text class="node-title" x={node.x + 15} y={node.y + 51}>
                  {node.lines.map((line, index) => <tspan x={node.x + 15} dy={index === 0 ? 0 : 14}>{line}</tspan>)}
                </text>
                <text class="node-state" x={node.x + fullNodeWidth - 15} y={node.y + fullNodeHeight - 12} text-anchor="end">{node.id === currentId ? 'CURRENT' : 'UNREAD'}</text>
              </>
            )}
          </a>
        ))}
      </g>
      </g>
    </svg>
    )}
  </div>

  {!compact && graphNodes.length > 0 && (
    <p class="graph-help"><span>Drag or scroll to travel the route. Hover or focus a node to trace its dependency chain. Select to open the report.</span><kbd>←</kbd><kbd>→</kbd><kbd>+</kbd><kbd>−</kbd></p>
  )}
</div>

<script>
  const GRAPH_STORAGE_KEY = 'physical-extremes:visited-reports';

  document.querySelectorAll<HTMLElement>('[data-report-graph]').forEach((graph) => {
    const nodes = [...graph.querySelectorAll<SVGAElement>('[data-graph-node]')];
    const edges = [...graph.querySelectorAll<SVGPathElement>('.graph-edge')];
    const viewport = graph.querySelector<HTMLElement>('.graph-viewport');
    const svg = viewport?.querySelector<SVGSVGElement>('svg');
    const stage = svg?.querySelector<SVGGElement>('[data-graph-stage]');
    const isCompact = graph.classList.contains('report-graph--compact');
    const currentId = graph.dataset.currentId;
    let visited = new Set<string>();
    let selectedFrontier = graph.querySelector<HTMLButtonElement>('[data-graph-route].is-selected')?.dataset.graphRoute ?? '';
    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let dragging = false;
    let suppressClick = false;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let pointerStartGraphX = 0;
    let pointerStartGraphY = 0;
    let startTranslateX = 0;
    let startTranslateY = 0;

    const VIEW_WIDTH = 1200;
    const VIEW_HEIGHT = 620;
    const NODE_WIDTH = 220;
    const NODE_HEIGHT = 88;
    const MIN_SCALE = 0.22;
    const MAX_SCALE = 3.2;
    const worldWidth = Number(viewport?.dataset.worldWidth ?? VIEW_WIDTH);
    const worldHeight = Number(viewport?.dataset.worldHeight ?? VIEW_HEIGHT);

    try {
      visited = new Set(JSON.parse(localStorage.getItem(GRAPH_STORAGE_KEY) ?? '[]'));
    } catch {
      visited = new Set();
    }

    if (currentId) visited.add(currentId);

    const persistVisited = () => {
      try {
        localStorage.setItem(GRAPH_STORAGE_KEY, JSON.stringify([...visited]));
      } catch {
        // Progress tracking is an enhancement; navigation still works without storage.
      }
    };

    const renderProgress = () => {
      nodes.forEach((node) => {
        const id = node.dataset.nodeId ?? '';
        const isVisited = visited.has(id);
        node.classList.toggle('is-visited', isVisited);
        const state = node.querySelector<SVGTextElement>('.node-state');
        if (state) state.textContent = id === currentId ? 'CURRENT' : isVisited ? 'VISITED' : 'UNREAD';
      });
      const count = graph.querySelector<HTMLElement>('[data-progress-count]');
      if (count) count.textContent = String(nodes.filter((node) => visited.has(node.dataset.nodeId ?? '')).length);
    };

    const updateZoomLabel = () => {
      const label = graph.querySelector<HTMLElement>('[data-zoom-level]');
      if (label) label.textContent = `${Math.round(scale * 100)}%`;
    };

    const clampTransform = () => {
      const margin = 70;
      const scaledWidth = worldWidth * scale;
      const scaledHeight = worldHeight * scale;

      if (scaledWidth <= VIEW_WIDTH - margin * 2) {
        translateX = (VIEW_WIDTH - scaledWidth) / 2;
      } else {
        translateX = Math.min(margin, Math.max(VIEW_WIDTH - scaledWidth - margin, translateX));
      }

      if (scaledHeight <= VIEW_HEIGHT - margin * 2) {
        translateY = (VIEW_HEIGHT - scaledHeight) / 2;
      } else {
        translateY = Math.min(margin, Math.max(VIEW_HEIGHT - scaledHeight - margin, translateY));
      }
    };

    const renderTransform = () => {
      if (!stage || isCompact) return;
      clampTransform();
      stage.setAttribute('transform', `translate(${translateX} ${translateY}) scale(${scale})`);
      updateZoomLabel();
    };

    const graphPoint = (clientX: number, clientY: number) => {
      const matrix = svg?.getScreenCTM();
      if (!matrix) return { x: VIEW_WIDTH / 2, y: VIEW_HEIGHT / 2 };
      const point = new DOMPoint(clientX, clientY).matrixTransform(matrix.inverse());
      return { x: point.x, y: point.y };
    };

    const preferredNodeScale = () => {
      const width = svg?.getBoundingClientRect().width ?? 1200;
      return Math.min(2.4, Math.max(0.85, 900 / width));
    };

    const zoomAt = (nextScale: number, focusX = VIEW_WIDTH / 2, focusY = VIEW_HEIGHT / 2) => {
      const boundedScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, nextScale));
      const worldX = (focusX - translateX) / scale;
      const worldY = (focusY - translateY) / scale;
      scale = boundedScale;
      translateX = focusX - worldX * scale;
      translateY = focusY - worldY * scale;
      renderTransform();
    };

    const routeNodes = (frontier = selectedFrontier) =>
      nodes.filter((node) => !frontier || node.dataset.frontier === frontier);

    const boundsFor = (items: SVGAElement[]) => {
      const positions = items.map((node) => ({
        x: Number(node.dataset.nodeX ?? 0),
        y: Number(node.dataset.nodeY ?? 0),
      }));
      return {
        minX: Math.min(...positions.map((point) => point.x)),
        maxX: Math.max(...positions.map((point) => point.x)) + NODE_WIDTH,
        minY: Math.min(...positions.map((point) => point.y)),
        maxY: Math.max(...positions.map((point) => point.y)) + NODE_HEIGHT,
      };
    };

    const centerNode = (node: SVGAElement, nextScale = Math.max(preferredNodeScale(), scale)) => {
      const x = Number(node.dataset.nodeX ?? 0) + NODE_WIDTH / 2;
      const y = Number(node.dataset.nodeY ?? 0) + NODE_HEIGHT / 2;
      scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, nextScale));
      translateX = VIEW_WIDTH * 0.32 - x * scale;
      translateY = VIEW_HEIGHT / 2 - y * scale;
      renderTransform();
    };

    const startRoute = (continueProgress = true) => {
      const items = routeNodes();
      if (!items.length) return;
      const firstUnread = items.find((node) => !visited.has(node.dataset.nodeId ?? ''));
      const latestVisited = [...items].reverse().find((node) => visited.has(node.dataset.nodeId ?? ''));
      centerNode(continueProgress ? firstUnread ?? latestVisited ?? items[0] : items[0], preferredNodeScale());
    };

    const fitItems = (items: SVGAElement[]) => {
      if (!items.length) return;
      const bounds = boundsFor(items);
      const padding = 100;
      const width = Math.max(1, bounds.maxX - bounds.minX);
      const height = Math.max(1, bounds.maxY - bounds.minY);
      scale = Math.min(1.15, Math.max(MIN_SCALE, Math.min((VIEW_WIDTH - padding * 2) / width, (VIEW_HEIGHT - padding * 2) / height)));
      translateX = VIEW_WIDTH / 2 - ((bounds.minX + bounds.maxX) / 2) * scale;
      translateY = VIEW_HEIGHT / 2 - ((bounds.minY + bounds.maxY) / 2) * scale;
      renderTransform();
    };

    const selectRoute = (frontier: string) => {
      selectedFrontier = frontier;
      graph.querySelectorAll<HTMLButtonElement>('[data-graph-route]').forEach((button) => {
        const selected = button.dataset.graphRoute === frontier;
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-pressed', String(selected));
      });
      startRoute();
    };

    const connectedIds = (anchorId: string) => {
      const ancestors = new Set([anchorId]);
      const descendants = new Set([anchorId]);
      let changed = true;

      while (changed) {
        changed = false;
        for (const edge of edges) {
          const from = edge.dataset.from ?? '';
          const to = edge.dataset.to ?? '';

          if (ancestors.has(to) && !ancestors.has(from)) {
            ancestors.add(from);
            changed = true;
          }
          if (descendants.has(from) && !descendants.has(to)) {
            descendants.add(to);
            changed = true;
          }
        }
      }
      return new Set([...ancestors, ...descendants]);
    };

    const activatePath = (anchorId: string) => {
      const active = connectedIds(anchorId);
      nodes.forEach((node) => {
        node.classList.toggle('is-active', active.has(node.dataset.nodeId ?? ''));
        node.classList.toggle('is-anchor', node.dataset.nodeId === anchorId);
      });
      edges.forEach((edge) => {
        edge.classList.toggle(
          'is-active',
          active.has(edge.dataset.from ?? '') && active.has(edge.dataset.to ?? ''),
        );
      });
    };

    const clearPath = () => {
      nodes.forEach((node) => node.classList.remove('is-active', 'is-anchor'));
      edges.forEach((edge) => edge.classList.remove('is-active'));
    };

    nodes.forEach((node) => {
      const id = node.dataset.nodeId ?? '';
      node.addEventListener('pointerenter', () => activatePath(id));
      node.addEventListener('pointerleave', clearPath);
      node.addEventListener('focus', () => {
        activatePath(id);
        if (!isCompact) centerNode(node);
      });
      node.addEventListener('blur', clearPath);
      node.addEventListener('click', () => {
        visited.add(id);
        persistVisited();
        renderProgress();
      });
    });

    graph.querySelectorAll<HTMLButtonElement>('[data-graph-route]').forEach((button) => {
      button.addEventListener('click', () => selectRoute(button.dataset.graphRoute ?? ''));
    });

    graph.querySelector<HTMLButtonElement>('[data-graph-action="start"]')?.addEventListener('click', () => startRoute(false));
    graph.querySelector<HTMLButtonElement>('[data-graph-action="fit"]')?.addEventListener('click', () => fitItems(nodes));
    graph.querySelector<HTMLButtonElement>('[data-graph-action="zoom-in"]')?.addEventListener('click', () => zoomAt(scale * 1.2));
    graph.querySelector<HTMLButtonElement>('[data-graph-action="zoom-out"]')?.addEventListener('click', () => zoomAt(scale / 1.2));

    if (viewport && svg && stage && !isCompact) {
      viewport.addEventListener('wheel', (event) => {
        if (event.ctrlKey || event.metaKey) {
          const point = graphPoint(event.clientX, event.clientY);
          zoomAt(scale * Math.exp(-event.deltaY * 0.002), point.x, point.y);
          event.preventDefault();
          return;
        }

        const previousX = translateX;
        const previousY = translateY;
        if (event.shiftKey || Math.abs(event.deltaX) > Math.abs(event.deltaY)) {
          translateX -= event.deltaX || event.deltaY;
        } else {
          translateX -= event.deltaY;
        }
        translateY -= event.deltaX === 0 ? 0 : event.deltaY * 0.35;
        renderTransform();
        if (previousX !== translateX || previousY !== translateY) event.preventDefault();
      }, { passive: false });

      viewport.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        dragging = true;
        suppressClick = false;
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
        const startPoint = graphPoint(event.clientX, event.clientY);
        pointerStartGraphX = startPoint.x;
        pointerStartGraphY = startPoint.y;
        startTranslateX = translateX;
        startTranslateY = translateY;
        viewport.setPointerCapture(event.pointerId);
        viewport.classList.add('is-dragging');
      });

      viewport.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const point = graphPoint(event.clientX, event.clientY);
        const dx = point.x - pointerStartGraphX;
        const dy = point.y - pointerStartGraphY;
        if (Math.hypot(event.clientX - pointerStartX, event.clientY - pointerStartY) > 4) suppressClick = true;
        translateX = startTranslateX + dx;
        translateY = startTranslateY + dy;
        renderTransform();
      });

      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        viewport.classList.remove('is-dragging');
        if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
      };

      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);
      viewport.addEventListener('click', (event) => {
        if (!suppressClick) return;
        event.preventDefault();
        event.stopPropagation();
        suppressClick = false;
      }, true);

      viewport.addEventListener('keydown', (event) => {
        const step = event.shiftKey ? 180 : 80;
        if (event.key === 'ArrowLeft') translateX += step;
        else if (event.key === 'ArrowRight') translateX -= step;
        else if (event.key === 'ArrowUp') translateY += step;
        else if (event.key === 'ArrowDown') translateY -= step;
        else if (event.key === '+' || event.key === '=') zoomAt(scale * 1.2);
        else if (event.key === '-' || event.key === '_') zoomAt(scale / 1.2);
        else if (event.key.toLowerCase() === 'f') fitItems(nodes);
        else if (event.key === 'Home' || event.key === '0') startRoute(false);
        else return;
        event.preventDefault();
        renderTransform();
      });

      startRoute();
    }

    persistVisited();
    renderProgress();
  });
</script>

<style>
  .report-graph {
    --graph-accent: #b8f45d;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #080a0a;
