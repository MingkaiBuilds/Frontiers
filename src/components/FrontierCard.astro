---
import type { CollectionEntry } from 'astro:content';
import type { FRONTIERS } from '@/data/frontiers';
import { withBase } from '@/utils/paths';

type Frontier = (typeof FRONTIERS)[number];

interface Props {
  frontier: Frontier;
  post?: CollectionEntry<'blog'>;
}

const { frontier, post } = Astro.props;
const articleHref = post ? withBase(`/reports/${post.id}/`) : '#reports';
---

<article
  id={frontier.id}
  class="frontier-card group relative flex min-h-[312px] scroll-mt-24 flex-col overflow-hidden border border-white/10 bg-[#0b0d0d] p-5 transition-colors duration-300 hover:border-white/25 md:p-6"
  style={`--frontier-color: ${frontier.color}`}
>
  <div class="card-scanline" aria-hidden="true"></div>
  <div class="relative flex items-start justify-between gap-4">
    <span class="font-mono text-[10px] tracking-[0.18em] text-zinc-600">FRONTIER / {frontier.index}</span>
    <span class="status-chip">ACTIVE</span>
  </div>

  <div class="relative mt-14">
    <p class="font-mono text-[9px] tracking-[0.2em] text-zinc-500 uppercase">{frontier.code}</p>
    <h3 class="mt-2 text-2xl font-medium tracking-[-0.04em] text-zinc-100">{frontier.name}</h3>
    <p class="mt-3 max-w-[31ch] text-sm leading-6 text-zinc-500">{frontier.description}</p>
  </div>

  <div class="relative mt-auto flex items-end justify-between gap-5 border-t border-white/8 pt-5">
    <div>
      <p class="font-mono text-lg tracking-[-0.04em] text-zinc-200">{frontier.metric}</p>
      <p class="mt-1 text-[9px] tracking-[0.14em] text-zinc-600 uppercase">{frontier.unit}</p>
    </div>
    {post ? (
      <a
        href={articleHref}
        class="card-link inline-flex items-center gap-2 text-[10px] font-semibold tracking-[0.14em] uppercase"
        aria-label={`Read the latest ${frontier.name} report`}
      >
        Open report <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <span class="font-mono text-[9px] tracking-[0.12em] text-zinc-700 uppercase">Awaiting report</span>
    )}
  </div>
</article>
